---
import BaseLayout from '../../../layouts/base-layout.astro';
import { getDictionary, resolveLocale } from '../../../i18n';
import BeforeSection from './before-section.astro';
import ClosingSection from './closing-section.astro';
import EcosystemSection from './ecosystem-section.astro';
import GridSection from './grid-section.astro';
import MarqueeBand from './marquee-band.astro';
import ScrollRail from './scroll-rail.astro';
import MethodSection from './method-section.astro';
import CasesSection from './cases-section.astro';
import OpeningSection from './opening-section.astro';
import TeamSection from './team-section.astro';

const locale = resolveLocale(Astro.currentLocale);
const t = getDictionary(locale);
---

<BaseLayout>
  <ScrollRail t={t} />
  <OpeningSection t={t} />
  <BeforeSection t={t} />
  <MarqueeBand items={t.marquee} />
  <MethodSection t={t} />
  <GridSection t={t} />
  <CasesSection t={t} />
  <TeamSection t={t} />
  <EcosystemSection t={t} />
  <ClosingSection t={t} />
</BaseLayout>

<script>
  import { initHomeMotion } from '../scripts/home-motion';

  initHomeMotion();
</script>
