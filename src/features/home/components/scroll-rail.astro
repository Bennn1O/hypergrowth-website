---
import type { Dictionary } from '../../../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const stageTitles = Object.fromEntries(t.timeline.stages.map((stage) => [stage.id, stage.title]));
---

<!--
  Custom scrollbar read like an instrument: a graduated ruler, major ticks on the moments
  of the relationship, and a needle carrying the current stage and time.
  Ticks are generated by the motion script; the native scrollbar is hidden only once it runs.
-->
<aside
  class="fixed top-36 right-3 bottom-8 z-40 hidden w-8 text-ink transition-colors duration-500 select-none sm:right-5 [.rail-dark_&]:text-paper [.rail-on_&]:block"
  data-rail
  data-stage-titles={JSON.stringify(stageTitles)}
  aria-label={t.a11y.clock}
>
  <div class="absolute inset-0 cursor-ns-resize" data-rail-ruler></div>
  <ol class="pointer-events-none absolute inset-0" data-rail-ticks></ol>
  <div class="pointer-events-none absolute top-0 right-0 h-px w-8" data-rail-needle>
    <span class="absolute inset-0 bg-pink"></span>
    <span class="absolute top-1/2 -right-[3px] size-[7px] -translate-y-1/2 rounded-full bg-pink"></span>
    <div class="absolute top-1/2 right-11 hidden -translate-y-1/2 text-right whitespace-nowrap transition-opacity duration-300 lg:block" data-rail-readout>
      <p class="label text-[9px] opacity-55" data-rail-stage>{t.timeline.stages[0].title}</p>
      <p class="mt-1 overflow-hidden text-[13px] leading-none font-medium tracking-[-0.02em] tabular-nums">
        <span class="inline-block" data-clock-display>{t.opening.clock}</span>
      </p>
    </div>
  </div>

  <!-- Phones: the same reading, parked bottom right, shown while scrolling. -->
  <div
    class="pointer-events-none absolute right-6 bottom-0 rounded-full bg-paper/90 px-3 py-2 text-right whitespace-nowrap opacity-0 shadow-sm backdrop-blur transition-opacity duration-300 [.rail-dark_&]:bg-ink/85 lg:hidden"
    data-rail-pill
  >
    <p class="label text-[9px] opacity-55" data-rail-stage>{t.timeline.stages[0].title}</p>
    <p class="mt-1 overflow-hidden text-[13px] leading-none font-medium tracking-[-0.02em] tabular-nums">
      <span class="inline-block" data-clock-display>{t.opening.clock}</span>
    </p>
  </div>
</aside>
