---
import type { Dictionary } from '../../../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
// TODO(HG): replace with real client logos (single-colour SVG in src/assets/clients/).
// The Figma template used third-party brand logos; they must not ship as HG references.
const logoSlots = [136, 92, 128, 123, 107];
---

<section
  aria-label={t.a11y.clients}
  class="mx-auto flex max-w-site flex-col items-center gap-8 px-6 py-8 sm:px-10 lg:flex-row lg:justify-between lg:px-20"
>
  <p class="max-w-[191px] text-center text-sm leading-normal font-medium text-subtle lg:text-left">{t.proof.label}</p>
  <ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-6 lg:contents" aria-hidden="true">
    {
      logoSlots.map((width) => (
        <li class="h-10 rounded-md border border-dashed border-subtle/60" style={`width: ${width}px`} />
      ))
    }
  </ul>
</section>
