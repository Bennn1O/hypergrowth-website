---
import ChapterBar from '../../../components/ui/chapter-bar.astro';
import SplitText from '../../../components/ui/split-text.astro';
import type { Dictionary } from '../../../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const d = t.tenDays;
---

<section
  id="dix-jours"
  class="relative px-4 pt-24 pb-32 sm:px-6"
  data-stage="dix-jours"
  data-clock={d.milestones[0].time}
  aria-labelledby="ten-days-title"
>
  <div class="mx-auto flex max-w-site flex-col gap-20 sm:gap-28">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5 lg:col-start-8">
        <ChapterBar prefix={t.chapter.prefix} chapter={d.chapter} index={3} />
      </div>
      <h2 id="ten-days-title" class="shout text-display lg:col-span-10">
        <SplitText text={d.title} class="block" />
        <SplitText text={d.accent} class="voice block text-purple" />
      </h2>
    </div>

    <div class="grid items-start gap-16 lg:grid-cols-12 lg:gap-x-6">
      <!-- The two documents: stacked, they fan out as you scroll (desktop). -->
      <div class="relative grid gap-6 sm:grid-cols-2 lg:col-span-7" data-clock={d.milestones[1].time} data-docs>
        {
          d.documents.map((doc, index) => (
            <article
              class="relative isolate flex aspect-[1/1.3] flex-col justify-between overflow-hidden rounded-xl bg-white p-6 shadow-[0_30px_60px_-30px_rgb(17_17_17/0.4),0_1px_3px_rgb(17_17_17/0.06)] sm:p-7"
              data-doc={index}
            >
              <div class="grain absolute inset-0 -z-10 opacity-20 mix-blend-multiply" aria-hidden="true" />
              <p class="label flex justify-between text-ink/40">
                <span>HyperGrowth™</span>
                <span class="text-pink">J+10</span>
              </p>
              <div class="flex flex-col gap-4">
                <span class="block h-1 w-10 bg-pink" aria-hidden="true" />
                <h3 class="display text-[clamp(1.9rem,2.6vw,2.6rem)] leading-none tracking-[-0.05em]">{doc.name}</h3>
                <p class="text-sm leading-snug font-medium text-ink/65">{doc.text}</p>
              </div>
            </article>
          ))
        }
      </div>

      <!-- What happens next, one line per milestone. -->
      <ol class="border-t border-ink/15 lg:col-span-4 lg:col-start-9" data-clock={d.milestones[2].time}>
        {
          d.milestones.map((milestone) => (
            <li class="grid grid-cols-[7.5rem_1fr] items-baseline gap-4 border-b border-ink/15 py-5" data-fade>
              <span class="display text-xl tracking-[-0.04em] text-pink tabular-nums">{milestone.time}</span>
              <span class="text-base leading-snug font-medium">{milestone.text}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <p class="shout text-center text-display" data-clock={d.milestones[3].time}>
      <SplitText text={d.statement} class="block" />
      <SplitText text={d.statementAccent} class="voice block text-purple" />
    </p>
  </div>
</section>
