---
import ChapterBar from '../../../components/ui/chapter-bar.astro';
import SplitText from '../../../components/ui/split-text.astro';
import type { Dictionary } from '../../../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const m = t.method;
const [first, ...rest] = m.steps;
---

<section id="methode" class="relative" data-stage="methode" data-clock={first.time} aria-labelledby="method-title">
  <div class="mx-auto flex max-w-site flex-col gap-12 px-4 pt-24 pb-20 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <ChapterBar prefix={t.chapter.prefix} chapter={m.chapter} index={2} />
      </div>
      <h2 id="method-title" class="section-title lg:col-span-11">
        <SplitText text={m.title} class="block" />
        <SplitText text={m.accent} class="voice block text-primary" />
      </h2>
      <p class="text-lead lg:col-span-5 lg:col-start-8">{m.intro}</p>
    </div>
  </div>

  <!-- Step panels: Figma (HYPERGROWTH, node 422:1539). The whole relationship in one horizontal track (pinned on desktop, stacked on mobile). -->
  <div class="relative overflow-hidden" data-hscroll>
    <div class="absolute inset-x-0 bottom-0 z-10 h-[3px] bg-ink/10" aria-hidden="true">
      <div class="h-full origin-left scale-x-0 bg-primary" data-hscroll-progress></div>
    </div>
    <div class="flex h-[100svh] w-max flex-row lg:h-dvh" data-hscroll-track>
      {
        [first, null, ...rest].map((step) =>
          step ? (
            <article
              class="relative isolate flex h-full w-screen flex-col overflow-hidden bg-white px-5 pt-24 pb-10 font-helvetica sm:px-8 lg:w-[72vw] lg:px-[49px] lg:pt-[112px] lg:pb-[56px]"
              data-clock={step.time}
              data-panel
            >
              <span
                class="pointer-events-none absolute right-[3%] -bottom-[0.25em] -z-10 text-[clamp(16rem,39.6vw,37.5rem)] lg:text-[31vw] leading-[0.75] font-medium tracking-[-0.045em] text-lilac select-none lg:right-[4.3%]"
                aria-hidden="true"
              >
                {m.steps.indexOf(step) + 1}
              </span>
              <header class="flex items-start justify-between gap-6 text-xs leading-3 font-medium tracking-[0.04em] uppercase">
                <p class="text-primary">{step.label}</p>
                <p class="text-black tabular-nums">{step.time}</p>
              </header>
              <div class="my-auto flex max-w-[1180px] flex-col gap-4">
                <ol class="flex flex-wrap items-center gap-2">
                  {step.points.map((point) => (
                    <li class="rounded-full border border-lilac bg-lilac px-[11px] py-[3px] text-xs leading-[18px] font-medium tracking-[-0.01em] text-primary">{point}</li>
                  ))}
                </ol>
                <h3 class="text-big font-normal text-ink">
                  {step.titleLead}<span class="font-serif font-semibold tracking-[-0.03em] text-primary italic">{step.titleAccent}</span>
                </h3>
                <p class="max-w-[719px] text-lead tracking-[-0.02em] text-black">{step.text}</p>
              </div>
              <p class="text-xs leading-3 font-medium tracking-[0.04em] text-ink/40 uppercase">
                {m.stepLabel} {m.steps.indexOf(step) + 1} / {m.steps.length}
              </p>
            </article>
          ) : (
            <article
              class="relative isolate flex h-full w-screen flex-col justify-end overflow-hidden bg-ink px-5 pt-24 pb-12 font-helvetica text-paper sm:px-8 lg:w-[56vw] lg:px-12 lg:pb-[66px]"
              data-clock={m.interlude.time}
              data-panel
              data-dark
            >
              <img
                src="/photos/diner.webp"
                srcset="/photos/diner-sm.webp 900w, /photos/diner.webp 2000w"
                sizes="(min-width: 1024px) 56vw, 100vw"
                alt=""
                loading="lazy"
                decoding="async"
                class="absolute inset-0 -z-20 h-full w-full object-cover"
                aria-hidden="true"
              />
              <div class="absolute inset-x-0 bottom-0 -z-10 h-2/3 bg-gradient-to-b from-transparent to-ink/70" aria-hidden="true" />
              <p class="mb-auto text-xs leading-3 font-medium tracking-[0.04em] text-blush uppercase">{m.interlude.label}</p>
              <p class="max-w-[874px] text-big font-normal">
                {m.interlude.title} <span class="font-serif font-semibold tracking-[-0.03em] text-pink italic">{m.interlude.accent}</span>
              </p>
              <p class="mt-10 max-w-[417px] text-lead text-paper/70">{m.interlude.text}</p>
            </article>
          ),
        )
      }
    </div>
  </div>
</section>
