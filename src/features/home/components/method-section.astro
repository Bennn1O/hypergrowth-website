---
import ChapterBar from '../../../components/ui/chapter-bar.astro';
import SplitText from '../../../components/ui/split-text.astro';
import type { Dictionary } from '../../../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const m = t.method;
const [first, ...rest] = m.steps;

/*
 * The panels alternate colours so the track is not a row of white cards:
 * white, (dark dinner), lilac, violet, white. Each theme keeps its own contrast.
 */
const themes = {
  white: {
    panel: 'bg-white',
    label: 'text-primary',
    time: 'text-black',
    pill: 'border-lilac bg-lilac text-primary',
    title: 'text-ink',
    accent: 'text-primary',
    text: 'text-black',
    step: 'text-ink/40',
    numeral: 'text-lilac',
    dark: false,
  },
  lilac: {
    panel: 'bg-lilac',
    label: 'text-primary',
    time: 'text-black',
    pill: 'border-white bg-white text-primary',
    title: 'text-ink',
    accent: 'text-primary',
    text: 'text-black',
    step: 'text-ink/50',
    numeral: 'text-white/70',
    dark: false,
  },
  violet: {
    panel: 'bg-primary',
    label: 'text-blush',
    time: 'text-white',
    pill: 'border-white/25 bg-white/15 text-white',
    title: 'text-white',
    accent: 'text-blush',
    text: 'text-white/85',
    step: 'text-white/55',
    numeral: 'text-white/12',
    dark: true,
  },
} as const;
const stepTheme = ['white', 'lilac', 'violet', 'white'] as const;
const themeOf = (step: (typeof m.steps)[number]) => themes[stepTheme[m.steps.indexOf(step)] ?? 'white'];
---

<section id="methode" class="relative" data-stage="methode" data-clock={first.time} aria-labelledby="method-title">
  <div class="mx-auto flex max-w-site flex-col gap-12 px-4 pt-24 pb-20 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <ChapterBar prefix={t.chapter.prefix} chapter={m.chapter} index={2} />
      </div>
      <h2 id="method-title" class="section-title lg:col-span-11">
        <SplitText text={m.title} class="block" />
        <SplitText text={m.accent} class="voice block text-primary" />
      </h2>
      <p class="text-lead lg:col-span-5 lg:col-start-8">{m.intro}</p>
    </div>
  </div>

  <!-- Step panels: Figma (HYPERGROWTH, node 422:1539). The whole relationship in one horizontal track (pinned on desktop, stacked on mobile). -->
  <div class="relative overflow-hidden" data-hscroll>
    <div class="absolute inset-x-0 bottom-0 z-10 h-[3px] bg-ink/10" aria-hidden="true">
      <div class="h-full origin-left scale-x-0 bg-primary" data-hscroll-progress></div>
    </div>
    <div class="flex h-[100svh] w-max flex-row lg:h-dvh" data-hscroll-track>
      {
        [first, null, ...rest].map((step) =>
          step ? (
            <article
              class:list={[
                'relative isolate flex h-full w-screen flex-col overflow-hidden px-5 pt-24 pb-10 font-helvetica sm:px-8 lg:w-[72vw] lg:px-[49px] lg:pt-[112px] lg:pb-[56px]',
                themeOf(step).panel,
              ]}
              data-clock={step.time}
              data-panel
              data-dark={themeOf(step).dark ? '' : undefined}
            >
              <span
                class:list={[
                  'pointer-events-none absolute right-[3%] bottom-[0.02em] -z-10 text-[clamp(16rem,39.6vw,37.5rem)] leading-[0.75] font-medium tracking-[-0.045em] select-none lg:right-[4.3%] lg:text-[31vw]',
                  themeOf(step).numeral,
                ]}
                aria-hidden="true"
              >
                {m.steps.indexOf(step) + 1}
              </span>
              <header class="flex items-start justify-between gap-6 text-xs leading-3 font-medium tracking-[0.04em] uppercase">
                <p class={themeOf(step).label}>{step.label}</p>
                <p class:list={['tabular-nums', themeOf(step).time]}>{step.time}</p>
              </header>
              <div class="my-auto flex max-w-[1180px] flex-col gap-4">
                <ol class="flex flex-wrap items-center gap-2">
                  {step.points.map((point) => (
                    <li class:list={['rounded-full border px-[11px] py-[3px] text-xs leading-[18px] font-medium tracking-[-0.01em]', themeOf(step).pill]}>{point}</li>
                  ))}
                </ol>
                <h3 class:list={['text-big font-normal', themeOf(step).title]}>
                  {step.titleLead}<span class:list={['font-serif font-semibold tracking-[-0.03em] italic', themeOf(step).accent]}>{step.titleAccent}</span>
                </h3>
                <p class:list={['max-w-[719px] text-lead tracking-[-0.02em]', themeOf(step).text]}>{step.text}</p>
              </div>
              <p class:list={['text-xs leading-3 font-medium tracking-[0.04em] uppercase', themeOf(step).step]}>
                {m.stepLabel} {m.steps.indexOf(step) + 1} / {m.steps.length}
              </p>
            </article>
          ) : (
            <article
              class="relative isolate flex h-full w-screen flex-col justify-end overflow-hidden bg-ink px-5 pt-24 pb-12 font-helvetica text-paper sm:px-8 lg:w-[56vw] lg:px-12 lg:pb-[66px]"
              data-clock={m.interlude.time}
              data-panel
              data-dark
            >
              <img
                src="/photos/diner.webp"
                srcset="/photos/diner-sm.webp 900w, /photos/diner.webp 2000w"
                sizes="(min-width: 1024px) 56vw, 100vw"
                alt=""
                loading="lazy"
                decoding="async"
                class="absolute inset-0 -z-20 h-full w-full object-cover"
                aria-hidden="true"
              />
              <div class="absolute inset-x-0 bottom-0 -z-10 h-2/3 bg-gradient-to-b from-transparent to-ink/70" aria-hidden="true" />
              <p class="mb-auto text-xs leading-3 font-medium tracking-[0.04em] text-blush uppercase">{m.interlude.label}</p>
              <p class="max-w-[874px] text-big font-normal">
                {m.interlude.title} <span class="font-serif font-semibold tracking-[-0.03em] text-pink italic">{m.interlude.accent}</span>
              </p>
              <p class="mt-10 max-w-[417px] text-lead text-paper/70">{m.interlude.text}</p>
            </article>
          ),
        )
      }
    </div>
  </div>
</section>
