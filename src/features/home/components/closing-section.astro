---
import SplitText from '../../../components/ui/split-text.astro';
import { site } from '../../../data/site';
import type { Dictionary } from '../../../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const c = t.closing;
const contactHref = site.email ? `mailto:${site.email}` : null;
---

<section
  id="cafe"
  data-dark
  class="relative isolate flex min-h-dvh flex-col justify-center overflow-hidden bg-ink px-4 py-32 text-paper sm:px-6"
  data-stage="maison"
  data-clock={c.clock}
  aria-labelledby="closing-title"
>
  <img src="/photos/bordeaux-2592.webp" alt="" loading="lazy" class="absolute inset-0 -z-20 h-full w-full object-cover opacity-45 grayscale" aria-hidden="true" />
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/70 to-ink/30" aria-hidden="true"></div>
  <div class="absolute inset-0 -z-10 opacity-40 mix-blend-screen" aria-hidden="true"><div class="nappes"></div></div>
  <div class="grain absolute inset-0 -z-10 opacity-50" aria-hidden="true"></div>

  <div class="mx-auto flex w-full max-w-site flex-col gap-12">
    <h2 id="closing-title" class="shout text-giant">
      <SplitText text={c.title} class="block" />
      <SplitText text={c.accent} class="voice block text-blush" />
    </h2>
    <div class="flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
      <p class="max-w-lg text-lead text-paper/85">{c.text}</p>
      {
        contactHref ? (
          <a href={contactHref} class="label bg-paper px-6 py-5 text-sm text-ink transition-colors hover:bg-pink">
            {c.cta} →
          </a>
        ) : (
          <p class="label border border-paper/40 px-6 py-5 text-sm text-paper/70">{c.pending}</p>
        )
      }
    </div>

    <div class="flex flex-col gap-5 pt-6">
      <p class="label text-paper/50">{c.meetLabel}</p>
      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {
          c.meet.map((item, index) => (
            <li class="group flex min-h-44 flex-col justify-between gap-8 rounded-xl border border-paper/12 bg-paper/6 p-5 backdrop-blur-sm transition-colors duration-500 hover:bg-paper hover:text-ink">
              <span class="flex items-center justify-between">
                <span class="label text-paper/45 group-hover:text-ink/45">{String(index + 1).padStart(2, '0')}</span>
                <span class="block size-2 rounded-full bg-pink" />
              </span>
              <span class="flex flex-col gap-2">
                <span class="display text-2xl leading-none tracking-[-0.045em]">{item.name}</span>
                <span class="text-sm leading-snug font-medium opacity-70">{item.text}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
