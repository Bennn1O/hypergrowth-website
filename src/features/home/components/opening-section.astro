---
import Logomark from '../../../assets/brand/logomark.svg';
import Logotype from '../../../assets/brand/logotype.svg';
import ChapterBar from '../../../components/ui/chapter-bar.astro';
import SplitText from '../../../components/ui/split-text.astro';
import type { Dictionary } from '../../../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const o = t.opening;
---

<!--
  Hero, built like a studio cover: the brand as the headline (top left), the positioning
  in the right column, a note bottom left, and the first chapter bar closing the screen.
  Two columns only: 1-6 and 7-12, shared with the next sections.
-->
<section
  class="relative flex min-h-dvh flex-col px-4 pt-20 pb-8 sm:px-6 sm:pt-20"
  data-stage="avant"
  data-clock={o.clock}
  data-opening
  aria-labelledby="opening-title"
>
  <div class="mx-auto grid w-full max-w-site flex-1 grid-cols-1 gap-y-10 lg:grid-cols-12 lg:grid-rows-[auto_1fr_auto] lg:gap-x-6">
    <!-- Logo: mark and wordmark caps share one height (wordmark box = caps x 1.32). -->
    <div class="flex w-fit flex-col gap-4 lg:col-span-8">
      <div class="flex items-start gap-[1vw] overflow-hidden text-pink" aria-hidden="true" data-hero-logo>
        <Logomark class="h-[9.5vw] w-auto shrink-0 lg:h-[6.8vw]" />
        <Logotype class="-mt-[0.3vw] h-[12.5vw] w-auto shrink-0 lg:-mt-[0.25vw] lg:h-[9vw] [&_.growth]:text-pink" />
      </div>
      <p class="label flex flex-wrap justify-between gap-x-6 gap-y-1 text-pink" data-fade>
        <span>{o.tagLeft}</span>
        <span>{o.tagRight}</span>
      </p>
    </div>

    <h1
      id="opening-title"
      class="display self-center text-[clamp(1.75rem,2.6vw,2.6rem)] leading-[1.08] tracking-[-0.045em] lg:col-span-5 lg:col-start-8 lg:row-start-2"
      data-intro-title
    >
      <SplitText text={o.statement} />
    </h1>

    <p class="max-w-sm self-end text-base leading-snug text-ink/80 lg:col-span-4 lg:row-start-3" data-fade>{o.note}</p>

    <div class="flex flex-col items-start gap-3 self-end lg:col-span-5 lg:col-start-8 lg:row-start-3" data-fade>
      <a href="#avant" class="label flex items-center gap-2 bg-ink px-3 py-2.5 text-paper transition-colors hover:bg-purple" data-magnetic>
        {o.cta} <span aria-hidden="true">↗</span>
      </a>
      <ChapterBar prefix={t.chapter.prefix} chapter={t.before.chapter} index={1} class="w-full" />
    </div>
  </div>
</section>
