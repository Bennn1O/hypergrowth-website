---
import { Image } from 'astro:assets';
import MediaPlaceholder from '../../../components/ui/media-placeholder.astro';
import type { Dictionary } from '../../../i18n';
import type { ProjectEntry } from '../data/get-projects';

interface Props {
  t: Dictionary;
  projects: ProjectEntry[];
}

const { t, projects } = Astro.props;
---

<section id="work" class="mx-auto max-w-site px-6 pt-4 pb-20 sm:px-[60px]" aria-labelledby="work-title">
  <h2 id="work-title" class="sr-only">{t.work.title}</h2>
  <ul class="grid gap-4 md:grid-cols-2">
    {
      projects.map((project) => (
        <li class="group relative h-[420px] overflow-hidden rounded-card lg:h-[534px]">
          {project.data.cover ? (
            <Image
              src={project.data.cover}
              alt={project.data.coverAlt ?? ''}
              widths={[640, 960, 1300]}
              sizes="(min-width: 768px) 50vw, 100vw"
              class="size-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
            />
          ) : (
            <MediaPlaceholder
              tone={project.data.tone}
              class="size-full transition-transform duration-700 group-hover:scale-[1.03]"
            />
          )}
          <div class="absolute inset-x-0 bottom-0 flex flex-col gap-3 bg-linear-to-t from-black/50 to-transparent p-7 pt-20 text-white">
            <h3 class="text-2xl font-medium">{project.data.title}</h3>
            <ul class="flex flex-wrap gap-3">
              {project.data.tags.map((tag) => (
                <li class="glass rounded-sm px-3 py-1.5 font-mono text-sm uppercase">{tag}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ul>
</section>
