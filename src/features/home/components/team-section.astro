---
import ChapterBar from '../../../components/ui/chapter-bar.astro';
import SplitText from '../../../components/ui/split-text.astro';
import type { Dictionary } from '../../../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const team = t.team;
const tones = ['bg-blush', 'bg-pink', 'bg-purple', 'bg-mist'];
---

<section class="relative px-4 pt-24 pb-32 sm:px-6" data-stage="ensuite" data-clock={t.after.clock} aria-labelledby="team-title">
  <div class="mx-auto flex max-w-site flex-col gap-16">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5 lg:col-start-8">
        <ChapterBar prefix={t.chapter.prefix} chapter={team.chapter} index={7} />
      </div>
      <h2 id="team-title" class="shout text-display lg:col-span-11">
        <SplitText text={team.title} class="block" />
        <SplitText text={team.accent} class="voice block text-purple" />
      </h2>
    </div>

    <ul class="grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {
        team.members.map((member, index) => (
          <li class="group flex flex-col gap-4" data-fade>
            <div
              class:list={['relative aspect-[4/5] overflow-hidden', tones[index % tones.length]]}
              style="clip-path: polygon(10% 0, 100% 0, 90% 100%, 0 100%);"
              aria-label={t.a11y.photo}
            >
              <div class="grain absolute inset-0 opacity-60 mix-blend-overlay" />
              <span class="absolute inset-0 flex items-center justify-center display text-[7rem] leading-none text-ink/15 transition-transform duration-700 ease-out-expo group-hover:scale-110">
                {member.name.charAt(0)}
              </span>
            </div>
            <div class="flex items-baseline justify-between gap-3 border-t border-ink pt-3">
              <p class="display text-2xl">{member.name}</p>
              <p class="label text-[10px] text-pink">{member.role}</p>
            </div>
            <p class="text-sm text-ink/70">{member.text}</p>
          </li>
        ))
      }
      <li class="flex items-end sm:col-span-2 lg:col-span-1">
        <p class="voice text-2xl text-ink/60">{team.more}</p>
      </li>
    </ul>
  </div>
</section>
