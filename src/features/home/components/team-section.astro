---
import Logomark from '../../../assets/brand/logomark.svg';
import ChapterBar from '../../../components/ui/chapter-bar.astro';
import SplitText from '../../../components/ui/split-text.astro';
import type { Dictionary } from '../../../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const team = t.team;
// Figma breaks the title after the comma: « Une petite équipe, / qui se déplace ».
const [titleLine1, titleLine2 = ''] = team.title.split(', ');

// Portraits we have so far (Figma). Others show the card without a photo until HG sends them.
const photos: Record<string, string> = { Killian: '/team/killian.webp', Ulysse: '/team/op-ulysse.webp',
  Benjamin: '/team/op-benjamin.webp',
  Julie: '/team/op-julie-ducourau.webp',
  Léa: '/team/lea.webp',
};
---

<!-- From Figma (HYPERGROWTH, node 376:717): « Les gens ». -->
<section
  id="maison"
  class="relative px-4 pt-24 pb-28 font-helvetica sm:px-6 lg:px-[75px]"
  data-stage="maison"
  data-clock={team.clock}
  aria-labelledby="team-title"
>
  <div class="mx-auto flex max-w-[1337px] flex-col gap-8 lg:pr-14">
    <div class="flex flex-col-reverse gap-8 lg:flex-row lg:items-start lg:justify-between">
      <h2 id="team-title" class="section-title text-ink">
        <SplitText text={`${titleLine1},`} class="block" />
        <SplitText text={titleLine2} />{' '}
        <SplitText text={team.accent} class="font-serif font-semibold tracking-[-0.03em] text-primary italic" />
      </h2>
      <ChapterBar prefix={t.chapter.prefix} chapter={team.chapter} index={5} class="rounded-[6px] lg:w-[593px]" />
    </div>

    <ul class="grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
      {
        team.members.map((member) => (
          <li class="group relative isolate aspect-[310/335] overflow-hidden rounded-[9px] bg-white" data-fade>
            {photos[member.name] ? (
              <img
                src={photos[member.name]}
                alt={member.name}
                loading="lazy" decoding="async"
                class="absolute inset-0 -z-20 h-full w-full object-cover transition-transform duration-700 ease-out-expo group-hover:scale-[1.04]"
              />
            ) : (
              <div class="absolute inset-0 -z-20 bg-[linear-gradient(160deg,#f3f3f1_0%,#e7e7e7_55%,#d9c4e6_100%)]" aria-hidden="true" />
            )}
            <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgb(47_33_61/0)_62%,#842cb4_100%)]" aria-hidden="true" />
            <div class="absolute inset-x-2 bottom-2 flex h-[52px] items-center overflow-hidden rounded-[3.5px] bg-ink/84 px-3 shadow-[inset_0_0_20px_rgb(255_255_255/0.06)] sm:inset-x-3 sm:bottom-3 sm:h-[60px]">
              <Logomark class="absolute -right-3 -bottom-8 h-[64px] w-auto text-[#252028]" aria-hidden="true" />
              <div class="relative flex flex-col items-start gap-[3px]">
                <span class="rounded-[4px] bg-pink/40 px-[5px] py-[4px] text-xs leading-[0.9] tracking-[-0.04em] text-white shadow-[inset_0_0_3px_rgb(255_255_255/0.2)]">
                  {member.name}
                </span>
                <span class="px-[5px] font-serif text-2xs leading-none font-semibold tracking-[-0.04em] text-white italic">{member.role}</span>
              </div>
            </div>
          </li>
        ))
      }
      <li class="col-span-2 mt-10 flex flex-col justify-end gap-4 sm:mt-8 lg:col-span-1 lg:mt-0 lg:gap-3">
        {
          team.experts.length > 0 && (
            <ul class="flex -space-x-3" aria-label={team.moreAccent}>
              {
                team.experts.map((expert) => (
                  <li>
                    <img
                      src={expert.photo}
                      alt={expert.name}
                      title={expert.name}
                      loading="lazy" decoding="async"
                      width="56"
                      height="56"
                      class="size-12 rounded-full object-cover ring-2 ring-paper transition-transform duration-300 hover:-translate-y-1 sm:size-14"
                    />
                  </li>
                ))
              }
            </ul>
          )
        }
        <p class="text-h3 tracking-[-0.005em] text-ink lg:max-w-[250px]">
          {team.moreLead}<span class="text-primary">{team.moreAccent}</span>{team.moreEnd}
        </p>
      </li>
    </ul>
  </div>
</section>
