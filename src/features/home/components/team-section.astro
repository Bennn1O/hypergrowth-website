---
import ChapterBar from '../../../components/ui/chapter-bar.astro';
import SplitText from '../../../components/ui/split-text.astro';
import type { Dictionary } from '../../../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const team = t.team;
---

<section id="maison" class="relative px-4 pt-24 pb-32 sm:px-6" data-stage="maison" data-clock={team.clock} aria-labelledby="team-title">
  <div class="mx-auto flex max-w-site flex-col gap-16">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5 lg:col-start-8">
        <ChapterBar prefix={t.chapter.prefix} chapter={team.chapter} index={5} />
      </div>
      <h2 id="team-title" class="shout text-display lg:col-span-11">
        <SplitText text={team.title} class="block" />
        <SplitText text={team.accent} class="voice block text-purple" />
      </h2>
    </div>

    <ul class="grid grid-cols-2 gap-x-3 gap-y-8 sm:gap-x-6 sm:gap-y-12 lg:grid-cols-4">
      {
        team.members.map((member, index) => (
          <li class="group flex flex-col gap-3 sm:gap-4" data-fade>
            <div
              class="relative aspect-[4/5] overflow-hidden rounded-lg bg-mist"
              aria-label={t.a11y.photo}
            >
              <div class="grain absolute inset-0 opacity-40 mix-blend-multiply" />
              <span class="absolute inset-0 flex items-center justify-center display text-[4.5rem] leading-none sm:text-[7rem] text-ink/10 transition-transform duration-700 ease-out-expo group-hover:scale-110">
                {member.name.charAt(0)}
              </span>
            </div>
            <div class="flex flex-col gap-1 border-t border-ink pt-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-3">
              <p class="display text-xl sm:text-2xl">{member.name}</p>
              <p class="label text-[10px] text-pink">{member.role}</p>
            </div>
            <p class="text-xs leading-snug text-ink/70 sm:text-sm">{member.text}</p>
          </li>
        ))
      }
      <li class="col-span-2 flex items-end lg:col-span-1">
        <p class="voice text-xl text-ink/60 sm:text-2xl">{team.more}</p>
      </li>
    </ul>
  </div>
</section>
