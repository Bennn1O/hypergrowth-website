---
import PhotoSlot from '../../../components/ui/photo-slot.astro';
import SplitText from '../../../components/ui/split-text.astro';
import type { Dictionary } from '../../../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const b = t.before;
---

<section id="avant" class="relative px-4 pt-24 pb-32 sm:px-6" data-stage="avant" data-clock={b.clock} aria-labelledby="before-title">
  <div class="mx-auto flex max-w-site flex-col gap-24 sm:gap-36">
    <!-- Centered statement flanked by photos, as on a studio cover. -->
    <div class="relative py-6 lg:py-24">
      <PhotoSlot label={t.a11y.photo} caption="Café Croissance" class="absolute top-0 left-0 hidden aspect-[4/5] w-[14vw] lg:block" />
      <PhotoSlot label={t.a11y.photo} caption="Dîner CEO" class="absolute right-0 bottom-0 hidden aspect-[5/4] w-[16vw] lg:block" />
      <h2 id="before-title" class="shout relative mx-auto max-w-5xl text-center text-display">
        <SplitText text={b.title} />{' '}
        <SplitText text={b.accent} class="voice text-pink" />
      </h2>
    </div>

    <div class="mx-auto max-w-md bg-ink p-6 text-paper sm:p-8" data-fade>
      {
        b.card.map((line, index) => (
          <p class:list={['text-lead', index > 0 && 'mt-4', index === 1 && 'text-blush']}>{line}</p>
        ))
      }
    </div>

    <p class="shout text-center text-title">
      <SplitText text={b.statement} class="block text-ink/35" />
      <SplitText text={b.statementAccent} class="voice block text-[1.6em] text-purple" />
    </p>

    <div class="grid gap-12 lg:grid-cols-12">
      <p class="text-lead lg:col-span-5">{b.posture}</p>
      <div class="flex flex-col gap-3 lg:col-span-5 lg:col-start-8">
        <p class="label text-pink">{b.whoLabel}</p>
        <p class="text-lead text-ink/75">{b.who}</p>
      </div>
    </div>

    <div class="flex flex-col gap-6">
      <p class="label text-ink/50">{b.meetLabel}</p>
      <ul class="border-t border-ink">
        {
          b.meet.map((item, index) => (
            <li class="group relative isolate border-b border-ink">
              <div class="flex flex-col gap-2 py-5 transition-[padding] duration-500 ease-out-expo sm:flex-row sm:items-baseline sm:justify-between sm:group-hover:pl-6">
                <span class="flex items-baseline gap-4">
                  <span class="display text-sm text-ink/40">{String(index + 1).padStart(2, '0')}</span>
                  <span class="display text-title ">{item.name}</span>
                </span>
                <span class="max-w-sm text-base text-ink/70 sm:text-right">{item.text}</span>
              </div>
              <span class="absolute inset-x-0 bottom-0 h-full origin-bottom scale-y-0 bg-blush/40 transition-transform duration-500 ease-out-expo group-hover:scale-y-100 -z-10" />
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
