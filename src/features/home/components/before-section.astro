---
import ChapterBar from '../../../components/ui/chapter-bar.astro';
import SplitText from '../../../components/ui/split-text.astro';
import type { Dictionary } from '../../../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const b = t.before;

// Floating photos (Figma « Post Header - Exploration », 422:2399): positions on a 1512 x 960 stage.
const floating = [
  { src: '/photos/bordeaux-2613.webp', x: 81, y: 50, speed: -0.25 },
  { src: '/photos/bordeaux-2637.webp', x: 1037, y: -9, speed: 0.2 },
  { src: '/photos/bordeaux-2658.webp', x: -74, y: 411, speed: 0.35 },
  { src: '/photos/bordeaux-2728.webp', x: 1391, y: 235, speed: -0.3 },
  { src: '/photos/bordeaux-2740.webp', x: 104, y: 682, speed: -0.15 },
  { src: '/photos/bordeaux-2592.webp', x: 1125, y: 682, speed: 0.25 },
];
const strip = ['/photos/bordeaux-2660.webp', '/photos/bordeaux-2706.webp', '/photos/bordeaux-2801.webp'];
---

<!-- From Figma (HYPERGROWTH, « Post Header - Exploration », node 422:2399). -->
<section
  id="avant"
  class="relative overflow-hidden bg-white px-4 pt-8 pb-16 font-helvetica sm:px-8"
  data-stage="avant"
  data-clock={b.clock}
  aria-labelledby="before-title"
>
  <div class="mx-auto flex max-w-[1448px] flex-col">
    <!-- Stage: centred statement among floating photos. -->
    <div class="relative aspect-[3/4] sm:aspect-[1448/930]">
      <ChapterBar prefix={t.chapter.prefix} chapter={b.chapter} index={1} class="relative z-10 lg:ml-auto lg:w-[41%]" />

      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        {
          floating.map((p) => (
            <figure
              class="absolute w-[20%] overflow-hidden rounded-[1.6px] bg-ink sm:w-[13.4%]"
              style={`left:${((p.x - 32) / 1448) * 100}%; top:${((p.y + 0) / 930) * 100}%; aspect-ratio:195/244;`}
              data-parallax={p.speed}
            >
              <img src={p.src} alt="" loading="lazy" class="h-full w-full object-cover grayscale" />
              <figcaption class="absolute bottom-2 left-2 hidden text-[7px] sm:block leading-none font-medium tracking-[0.04em] text-white/85 uppercase">
                {b.photoCaption}
              </figcaption>
            </figure>
          ))
        }
      </div>

      <h2
        id="before-title"
        class="absolute inset-x-0 top-1/2 mx-auto max-w-[1000px] -translate-y-1/2 px-6 text-center sm:top-[39.5%] sm:translate-y-0 font-helvetica text-[clamp(2.25rem,3.84vw,3.625rem)] leading-none font-normal tracking-[-0.0345em] text-ink"
      >
        {
          b.titleLines.map((line) => (
            <span class="block">
              {line.lead && <SplitText text={line.lead.trim()} />}
              {line.lead && line.accent && ' '}
              {line.accent && <SplitText text={line.accent} class="font-serif font-medium tracking-[-0.03em] text-primary italic" />}
              {line.end}
            </span>
          ))
        }
      </h2>
    </div>

    <!-- Statement, two intro lines, three photos. -->
    <div class="mt-16 flex flex-col gap-8 sm:mt-28 lg:mt-40">
      <p class="max-w-[790px] font-helvetica text-[clamp(2.25rem,3.84vw,3.625rem)] leading-none font-normal tracking-[-0.0345em] text-ink">
        <SplitText text={b.statementLead.trim()} />{' '}
        <SplitText text={b.statementAccent} class="font-serif font-medium tracking-[-0.03em] text-primary italic" />
      </p>
      <div class="flex flex-col gap-4 text-[clamp(1.05rem,1.47vw,1.39rem)] leading-[1.4] text-ink sm:flex-row sm:items-center sm:justify-between">
        <p class="max-w-[580px]">{b.introLeft}</p>
        <p class="max-w-[390px] sm:text-right">{b.introRight}</p>
      </div>
      <div class="grid grid-cols-3 gap-2 sm:gap-4">
        {
          strip.map((src) => (
            <figure class="relative aspect-[465/620] overflow-hidden rounded-lg bg-mist" data-fade>
              <img src={src} alt="" loading="lazy" class="absolute inset-0 h-full w-full object-cover grayscale" />
              <figcaption class="absolute bottom-3 left-3 hidden text-[10px] leading-none font-medium tracking-[0.04em] text-white/85 uppercase sm:block">
                {b.photoCaption}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>
