---
import PhotoSlot from '../../../components/ui/photo-slot.astro';
import SplitText from '../../../components/ui/split-text.astro';
import type { Dictionary } from '../../../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const b = t.before;
---

<section id="avant" class="relative px-4 pt-24 pb-32 sm:px-6" data-stage="avant" data-clock={b.clock} aria-labelledby="before-title">
  <div class="mx-auto flex max-w-site flex-col gap-24 sm:gap-36">
    <!-- Centered statement flanked by photos, as on a studio cover. -->
    <div class="relative py-6 lg:py-24">
      <PhotoSlot label={t.a11y.photo} caption={b.photoCaption} src="/photos/bordeaux-2613.webp" class="absolute top-0 left-0 hidden aspect-[4/5] w-[14vw] lg:block" />
      <PhotoSlot label={t.a11y.photo} caption={b.photoCaption} src="/photos/bordeaux-2592.webp" class="absolute right-0 bottom-0 hidden aspect-[3/2] w-[20vw] lg:block" />
      <h2 id="before-title" class="shout relative mx-auto max-w-5xl text-center text-display">
        <SplitText text={b.title} />{' '}
        <SplitText text={b.accent} class="voice text-pink" />
      </h2>
    </div>

    <!-- A strip of the room, between the card and the rest. -->
    <div class="grid grid-cols-3 gap-3 sm:gap-4" data-fade>
      {
        ['/photos/bordeaux-2660.webp', '/photos/bordeaux-2706.webp', '/photos/bordeaux-2801.webp'].map((src, i) => (
          <PhotoSlot
            label={t.a11y.photo}
            caption={b.photoCaption}
            src={src}
            class:list={['relative aspect-[3/4]', i === 1 && 'sm:translate-y-10']}
          />
        ))
      }
    </div>

    <div
      class="relative isolate mx-auto max-w-md overflow-hidden rounded-xl bg-ink p-6 text-paper shadow-[0_24px_60px_-20px_rgb(17_17_17/0.35),0_2px_6px_rgb(17_17_17/0.08)] sm:p-8"
      data-fade
    >
      <div class="grain absolute inset-0 -z-10 opacity-25 mix-blend-soft-light" aria-hidden="true"></div>
      {
        b.card.map((line, index) => (
          <p class:list={['text-lead font-medium tracking-[-0.025em]', index > 0 && 'mt-4', index === 1 && 'text-blush']}>{line}</p>
        ))
      }
    </div>

    <div class="grid gap-12 lg:grid-cols-12">
      <p class="text-lead lg:col-span-5">{b.posture}</p>
      <div class="flex flex-col gap-3 lg:col-span-5 lg:col-start-8">
        <p class="label text-pink">{b.whoLabel}</p>
        <p class="text-lead text-ink/75">{b.who}</p>
      </div>
    </div>

  </div>
</section>
