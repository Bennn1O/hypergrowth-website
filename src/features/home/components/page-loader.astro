---
import Logomark from '../../../assets/brand/logomark.svg';
---

<!--
  Loading screen: the HG symbol starts empty (light grey) and fills with violet from the bottom
  as the motion gets ready (home-motion sets --loader-progress from 0 to 1, then html.is-ready).
  Without JS it never shows; if the script fails it clears itself after 3s (global.css).
-->
<div class="page-loader" aria-hidden="true" data-loader>
  <span class="page-loader-mark relative block h-12 sm:h-14">
    <Logomark class="h-full w-auto text-line" />
    <Logomark class="page-loader-fill absolute inset-0 h-full w-auto text-primary" />
  </span>
</div>
