---
import ChapterBar from '../../../components/ui/chapter-bar.astro';
import SplitText from '../../../components/ui/split-text.astro';
import type { Dictionary } from '../../../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const e = t.ecosystem;
---

<section class="relative bg-ink px-4 pt-24 pb-32 text-paper sm:px-6" data-stage="ensuite" data-clock={t.after.clock} aria-labelledby="eco-title">
  <div class="mx-auto flex max-w-site flex-col gap-16 sm:gap-20">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <ChapterBar prefix={t.chapter.prefix} chapter={e.chapter} index={6} />
      </div>
      <h2 id="eco-title" class="shout text-display lg:col-span-11">
        <SplitText text={e.title} />{' '}
        <SplitText text={e.accent} class="voice text-pink" />
      </h2>
    </div>

    <ul class="border-t border-paper/25" data-eco>
      {
        e.items.map((item) => (
          <li class="group border-b border-paper/25" data-eco-item>
            <div class="grid grid-cols-1 gap-2 py-5 sm:grid-cols-12 sm:items-baseline sm:gap-6">
              <span class="label text-blush sm:col-span-2">{item.kind}</span>
              <span class="font-serif text-[clamp(2.2rem,5.5vw,5rem)] leading-[1] font-medium transition-[color,transform] duration-500 ease-out-expo group-hover:translate-x-3 group-hover:text-pink group-hover:italic sm:col-span-6">
                {item.name}
              </span>
              <span class="text-base text-paper/65 sm:col-span-4">{item.text}</span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Cursor-follow preview (desktop pointer only). -->
  <div
    class="pointer-events-none fixed top-0 left-0 z-30 hidden aspect-[4/5] w-56 overflow-hidden opacity-0"
    style="clip-path: polygon(14% 0, 100% 0, 86% 100%, 0 100%);"
    data-eco-preview
    aria-hidden="true"
  >
    <div class="absolute inset-0 bg-purple"><div class="nappes"></div></div>
    <p class="voice absolute inset-x-0 bottom-6 px-10 text-2xl text-paper" data-eco-preview-label></p>
  </div>
</section>
