---
import LaurelLeft from '../../../assets/brand/laurel-left.svg';
import LaurelRight from '../../../assets/brand/laurel-right.svg';
import MediaPlaceholder from '../../../components/ui/media-placeholder.astro';
import type { Dictionary } from '../../../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const avatarRows = [
  ['blush', 'pink', 'purple', 'pink', 'blush', 'purple'],
  ['purple', 'blush', 'pink', 'purple', 'pink'],
] as const;
---

<section class="px-3 py-2.5 sm:px-6" aria-labelledby="stats-title">
  <div class="relative mx-auto flex max-w-site flex-col gap-10 overflow-hidden rounded-panel bg-black p-6 sm:p-[60px] xl:flex-row xl:items-stretch xl:gap-[60px]">

    <div class="relative flex flex-col gap-10 text-white xl:w-[413px] xl:shrink-0">
      <h2 id="stats-title" class="relative z-10 text-statement leading-none">{t.stats.title}</h2>
      <p class="relative z-10 max-w-md text-base leading-[1.2]">{t.stats.description}</p>
    </div>

    <ul class="relative z-10 grid gap-6 md:grid-cols-3 xl:flex-1">
      <li class="relative flex min-h-[337px] flex-col justify-between overflow-hidden rounded-card bg-white p-6">
        <div class="relative -mx-6 flex flex-col gap-3 overflow-hidden" aria-hidden="true">
          {
            avatarRows.map((row, rowIndex) => (
              <div class:list={['flex justify-center gap-2.5', rowIndex === 1 && 'translate-x-9']}>
                {row.map((tone) => (
                  <MediaPlaceholder tone={tone} class="size-[60px] shrink-0 rounded-full" />
                ))}
              </div>
            ))
          }
          <div class="absolute inset-y-0 left-0 w-20 bg-linear-to-r from-white via-white/75 via-60% to-white/0"></div>
          <div class="absolute inset-y-0 right-0 w-20 bg-linear-to-l from-white via-white/75 via-60% to-white/0"></div>
        </div>
        <div class="flex flex-wrap items-end justify-between gap-x-4 gap-y-1">
          <p class="text-stat font-medium text-black uppercase">{t.stats.reachValue}</p>
          <p class="max-w-[118px] text-base leading-none text-[#717171]">{t.stats.reachLabel}</p>
        </div>
      </li>

      <li class="flex min-h-[337px] flex-col gap-12 rounded-[10.7px] bg-graphite p-6 text-white">
        <div class="flex flex-1 items-start justify-between gap-2">
          <div class="flex flex-col gap-1">
            <p class="text-[40px] leading-[1.4] font-medium uppercase">{t.stats.awardsValue}</p>
            <p class="text-sm leading-none">{t.stats.awardsLabel}</p>
          </div>
          <div class="relative flex h-[60px] w-[139px] shrink-0 items-start justify-center text-white">
            <LaurelLeft class="absolute inset-y-0 left-0 h-full w-auto" aria-hidden="true" />
            <p class="mt-2 w-[62px] text-center text-[9px] leading-[1.1] font-medium tracking-wide uppercase">{t.stats.awardBadge}</p>
            <LaurelRight class="absolute inset-y-0 right-0 h-full w-auto" aria-hidden="true" />
          </div>
        </div>
        <p class="text-base leading-normal">{t.stats.awardsDescription}</p>
      </li>

      <li class="min-h-[337px]" aria-hidden="true">
        <MediaPlaceholder tone="pink" class="size-full min-h-[337px] rounded-[10.7px]" />
      </li>
    </ul>
  </div>
</section>
