---
import ChapterBar from '../../../components/ui/chapter-bar.astro';
import SplitText from '../../../components/ui/split-text.astro';
import type { Dictionary } from '../../../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const g = t.grid;

// Where each card lands on the "table" (desktop): left/top in % of the stage, rotation in deg.
// A ring around the big words, leaving the centre-bottom clear for the accent.
const spots = [
  { x: 1, y: 6, r: -6 },
  { x: 18, y: 1, r: 4 },
  { x: 63, y: 2, r: -3 },
  { x: 81, y: 8, r: 6 },
  { x: 1, y: 52, r: 3 },
  { x: 13, y: 71, r: -5 },
  { x: 70, y: 71, r: 5 },
  { x: 83, y: 50, r: -4 },
];
---

<section class="relative" data-stage="methode" data-clock={g.clock} aria-labelledby="grid-title">
  <div class="mx-auto grid max-w-site gap-10 px-4 pt-16 sm:px-6 lg:grid-cols-12">
    <div class="lg:col-span-5 lg:col-start-8">
      <ChapterBar prefix={t.chapter.prefix} chapter={g.chapter} index={3} />
    </div>
    <p class="text-lead text-ink/80 lg:col-span-6">{g.intro}</p>
  </div>

  <!-- Stop-scroll moment (desktop): the stage pins, the cards are dealt one by one over the big words. -->
  <div class="relative flex h-[100svh] flex-col overflow-hidden pt-20 pr-12 pb-6 pl-4 sm:pl-6 lg:block lg:h-dvh lg:p-0" data-deck>
    <h2
      id="grid-title"
      class="section-title mx-auto max-w-site lg:absolute lg:inset-0 lg:flex lg:flex-col lg:items-center lg:justify-center lg:text-center"
      data-deck-title
    >
      <span>{g.title}</span>{' '}
      <span class="voice text-primary">{g.accent}</span>
    </h2>

    <ul class="relative mt-6 flex-1 lg:absolute lg:inset-y-0 lg:right-16 lg:left-0 lg:mt-0" data-cards>
      {
        g.items.map((item, index) => (
          <li
            class="group absolute inset-x-0 top-2 flex flex-col justify-between gap-4 rounded-xl bg-white p-5 lg:right-auto lg:aspect-square lg:gap-3 shadow-[0_30px_60px_-30px_rgb(17_17_17/0.5),0_0_0_1px_rgb(17_17_17/0.06)] transition-colors duration-500 hover:bg-ink hover:text-paper lg:absolute lg:top-[var(--y)] lg:left-[var(--x)] lg:w-[min(15.5rem,15vw)]"
            style={`--x: ${spots[index].x}%; --y: ${spots[index].y}%; --r: ${spots[index].r}deg;`}
            data-card
            data-r={spots[index].r}
          >
            <div class="flex items-start justify-between gap-4">
              <h3 class="shout text-xl leading-[1.05] xl:text-2xl">{item.name}</h3>
              <span class="display text-2xl leading-none text-primary">{String(index + 1).padStart(2, '0')}</span>
            </div>
            <p class="text-sm leading-snug opacity-75">{item.text}</p>
            <ul class="flex flex-wrap gap-1.5">
              {item.tags.map((tag) => (
                <li class="border border-current/25 px-2 py-1 text-xs">{tag}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>

    <p class="voice mt-4 text-center text-base text-ink/60 lg:absolute lg:inset-x-0 lg:bottom-6 lg:mt-0 lg:text-lg" data-deck-aside>{g.aside}</p>
  </div>
</section>
