---
import ChapterBar from '../../../components/ui/chapter-bar.astro';
import SplitText from '../../../components/ui/split-text.astro';
import type { Dictionary } from '../../../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const g = t.grid;

// Card spots from Figma (HYPERGROWTH, « Post Header - Exploration », node 418:1063), on a 1512 x 994 stage.
const spots = [
  { x: 181, y: 25 },
  { x: 37, y: 225 },
  { x: 1006, y: 25 },
  { x: 1144, y: 224 },
  { x: 35, y: 585 },
  { x: 173, y: 785 },
  { x: 1144, y: 585 },
  { x: 996, y: 785 },
];
---

<section class="relative bg-white font-helvetica" data-stage="methode" data-clock={g.clock} aria-labelledby="grid-title">
  <div class="mx-auto flex max-w-[1432px] flex-col gap-8 px-4 pt-10 sm:px-6 lg:flex-row lg:items-start lg:justify-between lg:px-0">
    <div class="flex max-w-[578px] flex-col gap-4">
      <p class="text-[clamp(1.4rem,1.85vw,1.75rem)] leading-[1.5] tracking-[-0.023em] text-ink">
        {g.introLead}<span class="text-primary">{g.introAccent}</span>{g.introEnd}
      </p>
      <p class="text-[clamp(1.05rem,1.49vw,1.4rem)] leading-[1.39] tracking-[-0.02em] text-ink">{g.introText}</p>
    </div>
    <ChapterBar prefix={t.chapter.prefix} chapter={g.chapter} index={3} class="lg:w-[583px]" />
  </div>

  <!-- Stop-scroll stage: the cards are dealt one by one around the title. -->
  <div class="relative flex flex-col px-4 pt-16 pb-20 sm:px-6 lg:block lg:h-dvh lg:overflow-hidden lg:px-0 lg:pt-16 lg:pb-3" data-deck>
   <!-- Desktop: a 1512 x 994 box (the Figma stage), as large as the screen below the header allows. -->
   <div class="contents lg:relative lg:mx-auto lg:block lg:aspect-[1512/994] lg:h-full lg:max-w-full" data-deck-box>
   <!-- The Figma canvas at its native 1512 x 994, scaled to the box by the motion script (--s). -->
   <div class="contents lg:absolute lg:top-0 lg:left-0 lg:block lg:h-[994px] lg:w-[1512px] lg:origin-top-left lg:scale-(--s)">
    <div
      class="mx-auto flex max-w-[698px] flex-col items-center gap-5 text-center lg:absolute lg:top-0 lg:bottom-0 lg:left-[407px] lg:w-[698px] lg:justify-center"
      data-deck-title
    >
      <h2 id="grid-title" class="text-[clamp(2.4rem,5.95vw,5.625rem)] leading-[1.02] tracking-[-0.0345em] text-ink lg:text-[90px]">
        <SplitText text={g.title} />{' '}
        <SplitText text={g.accent} class="font-serif font-medium tracking-[-0.03em] text-primary italic" />
      </h2>
      <p class="hidden text-[19.7px] leading-snug tracking-[-0.005em] text-ink lg:block" data-deck-aside>{g.aside}</p>
    </div>

    <!-- Phones and tablets: a compact two-column grid; desktop: the dealt stage. -->
    <ul class="mt-10 grid grid-cols-2 gap-2 sm:gap-3 lg:absolute lg:inset-0 lg:mt-0 lg:block" data-cards>
      {
        g.items.map((item, index) => (
          <li
            class="relative flex flex-col justify-between gap-4 rounded-[3px] bg-ink p-3 sm:p-4 lg:absolute lg:gap-0 lg:p-[18px] text-white shadow-[inset_0_0_16px_rgb(255_255_255/0.05),0_20px_40px_-24px_rgb(17_17_17/0.5)] lg:right-auto lg:left-[var(--x)] lg:top-[var(--y)] lg:h-[168px] lg:w-[333px]"
            style={`--x: ${spots[index].x}px; --y: ${spots[index].y}px;`}
            data-card
            data-r="0"
          >
            <div class="flex flex-col gap-[9px]">
              <div class="flex items-start justify-between gap-2 font-serif text-[17px] leading-[0.95] sm:text-[20px] lg:items-center lg:gap-4 lg:text-[19px] font-medium tracking-[-0.04em] italic">
                <h3>{item.name}</h3>
                <span class="text-pink">{String(index + 1).padStart(2, '0')}</span>
              </div>
              <p class="text-[11.5px] leading-[1.2] tracking-[-0.02em] text-white/80 lg:max-w-[205px] lg:text-white lg:text-[11px] lg:leading-none lg:tracking-[-0.04em]">{item.text}</p>
            </div>
            <ul class="flex flex-wrap gap-1 lg:max-w-[180px] lg:gap-[9px] lg:pt-6">
              {item.tags.map((tag) => (
                <li class="rounded-[3px] bg-pink/40 px-1 py-[3px] text-[10.5px] leading-[0.9] lg:text-[12.6px] tracking-[-0.04em] shadow-[inset_0_0_2.5px_rgb(255_255_255/0.2)]">
                  {tag}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>

    <p class="mt-6 text-center text-base text-ink/60 lg:hidden">{g.aside}</p>
   </div>
   </div>
  </div>
</section>
