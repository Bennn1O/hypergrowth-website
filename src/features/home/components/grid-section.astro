---
import ChapterBar from '../../../components/ui/chapter-bar.astro';
import SplitText from '../../../components/ui/split-text.astro';
import type { Dictionary } from '../../../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const g = t.grid;

// Deterministic "posées sur la table" offsets, undone on scroll (desktop only).
const scatter = [
  { x: -8, y: 30, r: -9 },
  { x: 12, y: -20, r: 6 },
  { x: -18, y: 45, r: 11 },
  { x: 6, y: -35, r: -5 },
  { x: 20, y: 15, r: 8 },
  { x: -10, y: -40, r: -12 },
  { x: 14, y: 35, r: 4 },
  { x: -16, y: -10, r: -7 },
];
---

<section class="relative px-4 pt-16 pb-32 sm:px-6" data-stage="ensuite" data-clock={t.after.clock} aria-labelledby="grid-title">
  <div class="mx-auto flex max-w-site flex-col gap-16 sm:gap-24">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5 lg:col-start-8">
        <ChapterBar prefix={t.chapter.prefix} chapter={g.chapter} index={5} />
      </div>
      <h2 id="grid-title" class="shout text-display lg:col-span-11">
        <SplitText text={g.title} />{' '}
        <SplitText text={g.accent} class="voice text-pink" />
      </h2>
      <p class="text-lead text-ink/80 lg:col-span-6">{g.intro}</p>
    </div>

    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-cards>
      {
        g.items.map((item, index) => (
          <li
            class="group flex aspect-square flex-col justify-between gap-4 bg-mist p-5 transition-colors duration-500 hover:bg-ink hover:text-paper sm:p-6"
            data-card
            data-x={scatter[index].x}
            data-y={scatter[index].y}
            data-r={scatter[index].r}
          >
            <div class="flex items-start justify-between gap-4">
              <h3 class="shout text-2xl leading-[1.05] xl:text-3xl">{item.name}</h3>
              <span class="display text-3xl leading-none text-pink">{String(index + 1).padStart(2, '0')}</span>
            </div>
            <p class="text-sm opacity-75 sm:text-base">{item.look}</p>
            <div class="flex flex-col gap-2">
              <p class="label text-[10px] text-purple group-hover:text-blush">{g.expertsLabel}</p>
              <ul class="flex flex-wrap gap-1.5">
                {item.experts.map((expert) => (
                  <li class="border border-current/25 px-2 py-1 text-xs">{expert}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="voice text-center text-xl text-ink/60 sm:text-2xl">{g.aside}</p>
  </div>
</section>
