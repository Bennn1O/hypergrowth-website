---
import Icon from '../../../components/ui/icon.astro';
import MediaPlaceholder from '../../../components/ui/media-placeholder.astro';
import type { Dictionary } from '../../../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const [firstLine, secondLine] = t.hero.titleLines;
const avatarTones = ['blush', 'pink', 'purple', 'pink', 'blush'] as const;
---

<section class="px-3 pt-2.5 sm:px-3" aria-labelledby="hero-title">
  <div class="relative mx-auto max-w-site overflow-hidden rounded-panel lg:h-[850px]">
    <MediaPlaceholder tone="purple" class="absolute inset-0" />

    <div class="relative flex flex-col items-center gap-6 px-6 pt-20 pb-16 text-center text-white lg:absolute lg:top-[78px] lg:right-0 lg:left-1/2 lg:p-0">
      <h1 id="hero-title" class="text-display tracking-[-0.012em] text-balance">
        <span class="block">{firstLine}</span>
        <span class="block font-serif italic">{secondLine}</span>
      </h1>
      <p class="flex flex-wrap items-center justify-center gap-4 text-lg font-medium tracking-[0.012em]">
        <span>{t.hero.socialProofBefore}</span>
        <span class="flex -space-x-2" aria-hidden="true">
          {
            avatarTones.map((tone) => (
              <MediaPlaceholder tone={tone} class="size-8 rounded-full border-2 border-white" />
            ))
          }
        </span>
        <span>{t.hero.socialProofAfter}</span>
      </p>
      <p class="max-w-[554px] text-lg leading-[1.2] font-medium text-white/90">{t.hero.description}</p>
    </div>

    <nav
      aria-label={t.nav.services}
      class="relative mx-3 mb-3 grid gap-px rounded-card bg-white sm:grid-cols-3 lg:absolute lg:bottom-0 lg:left-1/2 lg:m-0 lg:w-[1122px] lg:-translate-x-1/2 lg:rounded-none lg:rounded-t-lg"
    >
      {
        t.quickLinks.map((link, index) => (
          <a
            href={link.href}
            class="group flex flex-col gap-8 p-5 transition-colors hover:bg-mist/50 lg:gap-[45px]"
          >
            <span class="flex items-center justify-between text-base">
              {link.label}
              <Icon
                name="arrow-up-right"
                class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              />
            </span>
            <span class="flex items-end justify-between gap-4">
              <span class="max-w-[219px] text-2xl leading-[1.2]">{link.title}</span>
              <MediaPlaceholder
                tone={(['blush', 'pink', 'purple'] as const)[index % 3]}
                class="h-[97px] w-[85px] shrink-0 rounded-md"
              />
            </span>
          </a>
        ))
      }
    </nav>
  </div>
</section>
