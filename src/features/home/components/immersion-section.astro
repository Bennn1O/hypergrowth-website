---
import ChapterBar from '../../../components/ui/chapter-bar.astro';
import SplitText from '../../../components/ui/split-text.astro';
import type { Dictionary } from '../../../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const im = t.immersion;
const [lunch, dinner] = im.interludes;

// Track order: phase, lunch, phase, dinner, phase, phase.
type Panel =
  | { kind: 'phase'; index: number; phase: (typeof im.phases)[number] }
  | { kind: 'interlude'; interlude: (typeof im.interludes)[number] };
const panels: Panel[] = [
  { kind: 'phase', index: 0, phase: im.phases[0] },
  { kind: 'interlude', interlude: lunch },
  { kind: 'phase', index: 1, phase: im.phases[1] },
  { kind: 'interlude', interlude: dinner },
  { kind: 'phase', index: 2, phase: im.phases[2] },
  { kind: 'phase', index: 3, phase: im.phases[3] },
];
---

<section id="immersion" class="relative" data-stage="immersion" data-clock={`${im.phases[0].day} · ${im.phases[0].start}`} aria-labelledby="immersion-title">
  <div class="mx-auto flex max-w-site flex-col gap-16 px-4 pt-24 pb-24 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <ChapterBar prefix={t.chapter.prefix} chapter={im.chapter} index={2} />
      </div>
      <h2 id="immersion-title" class="shout text-giant lg:col-span-12">
        <SplitText text={im.title} class="block" />
        <SplitText text={im.accent} class="voice block text-pink" />
      </h2>
    </div>

    <div class="grid gap-12 lg:grid-cols-12">
      <p class="text-lead lg:col-span-5">{im.intro}</p>
      <div class="lg:col-span-6 lg:col-start-7">
        <p class="label mb-4 text-ink/50">{im.rulesLabel}</p>
        <ol class="border-t border-ink/20">
          {
            im.rules.map((rule, index) => (
              <li class="flex items-baseline gap-5 border-b border-ink/20 py-3" data-fade>
                <span class="display text-sm text-pink">{String(index + 1).padStart(2, '0')}</span>
                <span class="shout text-xl sm:text-2xl">{rule}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>

  <!-- Horizontal track (pinned on large screens, stacked on mobile). -->
  <div class="relative overflow-hidden" data-hscroll>
    <div class="absolute inset-x-0 bottom-0 z-10 hidden h-[3px] bg-ink/10 lg:block" aria-hidden="true">
      <div class="h-full origin-left scale-x-0 bg-pink" data-hscroll-progress></div>
    </div>
    <div class="flex flex-col lg:h-dvh lg:w-max lg:flex-row" data-hscroll-track>
      {
        panels.map((panel) =>
          panel.kind === 'phase' ? (
            <article
              class="relative isolate flex flex-col justify-between gap-10 overflow-hidden border-t border-ink/15 px-4 py-16 sm:px-6 lg:h-full lg:w-[78vw] lg:border-t-0 lg:border-l lg:px-12 lg:pt-28 lg:pb-12"
              data-clock={`${panel.phase.day} · ${panel.phase.start}`}
              data-panel
            >
              <span
                class="outline-text pointer-events-none absolute -z-10 right-6 bottom-0 display text-[clamp(10rem,30vw,34rem)] leading-[0.75] select-none lg:right-12"
                aria-hidden="true"
              >
                {panel.index + 1}
              </span>
              <header class="flex items-start justify-between gap-6">
                <p class="label text-ink/50">
                  {im.phaseLabel} {panel.index + 1} / 4
                </p>
                <p class="label tabular-nums">
                  {panel.phase.day} · {panel.phase.start} → {panel.phase.end}
                </p>
              </header>
              <div class="grid gap-10 lg:grid-cols-12">
                <h3 class="display text-giant lg:col-span-12">
                  <span class="voice text-purple">{panel.phase.name}</span>
                </h3>
                <p class="text-lead lg:col-span-5">{panel.phase.text}</p>
                <ol class="flex flex-col gap-3 lg:col-span-4 lg:col-start-8">
                  {panel.phase.steps.map((step) => (
                    <li class="shout flex items-baseline gap-3 text-xl">
                      <span class="inline-block size-2 shrink-0 rotate-45 bg-pink" />
                      {step}
                    </li>
                  ))}
                </ol>
              </div>
              <p class="flex flex-col gap-1 border-t border-ink pt-4 sm:flex-row sm:items-baseline sm:gap-6">
                <span class="label shrink-0 text-pink">{im.exitLabel}</span>
                <span class="display text-lg">{panel.phase.exit}</span>
              </p>
            </article>
          ) : (
            <article
              class="relative isolate flex flex-col justify-end overflow-hidden bg-ink px-4 py-24 text-paper sm:px-6 lg:h-full lg:w-[62vw] lg:px-12 lg:pb-16"
              data-clock={panel.interlude.time}
              data-panel
              data-dark
            >
              <div class="absolute inset-0 -z-10 opacity-45" aria-hidden="true">
                <div class="nappes" />
              </div>
              <div class="grain absolute inset-0 -z-10 opacity-40" aria-hidden="true" />
              <p class="label mb-auto flex justify-between text-blush">
                <span>{panel.interlude.label}</span>
                <span class="tabular-nums">{panel.interlude.time}</span>
              </p>
              <p class="shout mt-16 text-display">
                {panel.interlude.title} <span class="voice text-pink">{panel.interlude.accent}</span>
              </p>
              <p class="mt-8 max-w-md text-lead text-paper/70">{panel.interlude.text}</p>
            </article>
          ),
        )
      }
    </div>
  </div>

  <div class="mx-auto flex max-w-site flex-col gap-10 px-4 pt-28 pb-32 sm:px-6">
    <h3 class="shout text-title">
      {im.partitionTitle} <span class="voice text-pink">{im.partitionAccent}</span>
    </h3>
    <ul class="flex flex-col gap-2 lg:h-[26rem] lg:flex-row" data-doors>
      {
        im.partition.map((door, index) => (
          <li class="group relative flex flex-1 flex-col justify-between gap-8 overflow-hidden bg-mist p-6 transition-[flex-grow,background-color,color] duration-700 ease-out-expo hover:bg-purple hover:text-paper lg:hover:flex-[2.4]">
            <span class="display text-giant leading-none text-ink/10 transition-colors group-hover:text-paper/20">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="flex flex-col gap-3">
              <span class="shout text-2xl sm:text-3xl">{door.name}</span>
              <span class="max-w-xs text-base opacity-75">{door.text}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
