---
import type { Dictionary } from '../../../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<section id="studio" class="flex flex-col items-center gap-12 px-6 py-16 text-center sm:px-20 lg:gap-[70px] lg:py-[60px]">
  <p class="max-w-[978px] text-statement">
    {t.statement.lead}<span class="text-quiet">{t.statement.quiet}</span>
  </p>
  <p class="text-xl leading-normal sm:text-2xl">
    {t.statement.subLead}<br />{t.statement.subLead2}<span class="text-quiet">{t.statement.subQuiet}</span>
  </p>
</section>
