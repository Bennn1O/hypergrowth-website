---
import Logo from '../../../components/ui/logo.astro';
import type { Dictionary } from '../../../i18n';

interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
---

<!-- Shown only when JS runs (html.js), lifted by the motion script. -->
<div
  class="fixed inset-0 z-[60] hidden flex-col justify-between bg-ink p-6 text-paper [.js_&]:flex"
  data-loader
  aria-hidden="true"
>
  <div class="text-[26px]"><Logo tone="light" /></div>
  <p class="voice overflow-hidden text-[clamp(3.5rem,14vw,12rem)] leading-none text-pink">
    <span class="inline-block" data-loader-clock>{t.opening.clock}</span>
  </p>
  <div class="flex items-end justify-between gap-6">
    <p class="label text-paper/50">{t.opening.eyebrow}</p>
    <span class="block h-px w-1/3 origin-left scale-x-0 bg-pink" data-loader-bar></span>
  </div>
</div>
