---
/** Rules of the immersion, looping horizontally; speeds up with the scroll. */
interface Props {
  items: string[];
}

const { items } = Astro.props;
const run = [...items, ...items];
---

<div class="overflow-hidden border-y border-ink bg-pink py-4 text-ink" aria-hidden="true" data-marquee>
  <div class="flex w-max" data-marquee-track>
    {
      [0, 1].map(() => (
        <div class="flex shrink-0 items-center">
          {run.map((item) => (
            <span class="flex items-center">
              <span class="shout px-6 text-2xl whitespace-nowrap sm:text-4xl">{item}</span>
              <span class="voice text-2xl sm:text-4xl">✳</span>
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>
