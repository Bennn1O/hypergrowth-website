---
/** Rules of the immersion, looping horizontally; speeds up and leans with the scroll. */
interface Props {
  items: string[];
}

const { items } = Astro.props;
const run = [...items, ...items];
---

<div class="overflow-hidden border-y border-ink/15 py-6 text-ink" aria-hidden="true" data-marquee>
  <div class="flex w-max will-change-transform" data-marquee-track>
    {
      [0, 1].map(() => (
        <div class="flex shrink-0 items-center">
          {run.map((item) => (
            <span class="flex items-center">
              <span class="display px-8 text-big leading-none tracking-[-0.05em] whitespace-nowrap">{item}</span>
              <span class="block size-2.5 shrink-0 bg-primary" />
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>
