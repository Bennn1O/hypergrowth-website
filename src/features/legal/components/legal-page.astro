---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../../layouts/base-layout.astro';
import { getDictionary, localizePath, resolveLocale } from '../../../i18n';

const locale = resolveLocale(Astro.currentLocale);
const t = getDictionary(locale);
const entry = await getEntry('legal', locale);
if (!entry) throw new Error(`Missing legal notice for ${locale}`);
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} | HyperGrowth`} description={entry.data.description} staticHeader>
  <section class="bg-[linear-gradient(180deg,#ff82fd_0%,#ffffff_70%)] px-3 pt-24 pb-3 font-helvetica sm:px-[30px] sm:pt-28">
    <article class="mx-auto max-w-[1452px] rounded-[24px] bg-white px-5 py-14 sm:px-[59px] sm:py-20">
      <div class="mx-auto flex max-w-[760px] flex-col gap-12">
        <header class="flex flex-col gap-4">
          <p class="text-xs font-medium tracking-[0.04em] text-primary uppercase">{t.legalPage.label}</p>
          <h1 class="text-h2 text-ink">{entry.data.title}</h1>
        </header>
        <div
          class="flex flex-col gap-4 text-base leading-[1.6] text-ink/80 [&_a]:text-primary [&_a]:underline [&_a]:underline-offset-2 [&_h2]:mt-8 [&_h2]:text-h3 [&_h2]:text-ink [&_li]:pl-1 [&_ul]:flex [&_ul]:list-disc [&_ul]:flex-col [&_ul]:gap-1 [&_ul]:pl-5"
        >
          <Content />
        </div>
        <a href={localizePath('/', locale)} class="self-start rounded-[4px] bg-ink px-3 py-2 text-sm leading-3 font-medium tracking-[0.034em] text-paper uppercase hover:bg-primary">
          ← {t.legalPage.back}
        </a>
      </div>
    </article>
  </section>
</BaseLayout>
