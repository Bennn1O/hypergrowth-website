---
/**
 * Photo block. With `src`, shows the photo (black and white, colour on hover);
 * without, a neutral placeholder. Size and position come from `class`.
 */
interface Props {
  label: string;
  caption: string;
  src?: string;
  class?: string;
}

const { label, caption, src, class: className } = Astro.props;
---

<figure class:list={['photo-slot group/photo overflow-hidden rounded-lg bg-mist', className]} aria-label={label}>
  {
    src ? (
      <img
        src={src}
        alt=""
        loading="lazy"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover grayscale transition-[filter,transform] duration-700 ease-out-expo group-hover/photo:scale-[1.03] group-hover/photo:grayscale-0"
      />
    ) : (
      <div class="grain absolute inset-0 opacity-40 mix-blend-multiply" />
    )
  }
  <figcaption class:list={['label absolute bottom-3 left-3 text-[10px]', src ? 'text-white/85' : 'text-ink/45']}>{caption}</figcaption>
</figure>
