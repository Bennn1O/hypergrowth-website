---
/**
 * Neutral placeholder for a real photo (immersion, dîner, équipe).
 * Swap for an <Image> once HG provides the shots. Size and position come from `class`.
 */
interface Props {
  label: string;
  caption: string;
  class?: string;
}

const { label, caption, class: className } = Astro.props;
---

<figure class:list={['photo-slot overflow-hidden bg-mist', className]} aria-label={label}>
  <div class="grain absolute inset-0 opacity-40 mix-blend-multiply"></div>
  <figcaption class="label absolute bottom-3 left-3 text-[10px] text-ink/45">{caption}</figcaption>
</figure>
