---
/**
 * Placeholder for a real photo (immersion, dîner, équipe), cut as a parallelogram.
 * Swap the inner gradient for an <Image> once HG provides the shots.
 * Positioning (relative/absolute, size) comes from `class`.
 */
interface Props {
  label: string;
  caption: string;
  skew?: 'left' | 'right';
  class?: string;
  speed?: number;
}

const { label, caption, skew = 'left', class: className, speed = 0.15 } = Astro.props;
const clip =
  skew === 'left'
    ? 'polygon(14% 0, 100% 0, 86% 100%, 0 100%)'
    : 'polygon(0 0, 86% 0, 100% 100%, 14% 100%)';
---

<figure class:list={['photo-slot', className]} data-parallax={speed} aria-label={label}>
  <div class="relative h-full w-full">
    <div class="absolute inset-0 overflow-hidden bg-purple" style={`clip-path: ${clip};`}>
      <div class="nappes"></div>
      <div class="grain absolute inset-0 opacity-70 mix-blend-overlay"></div>
    </div>
    <figcaption class="label absolute bottom-2 left-[16%] text-[10px] text-white/80">{caption}</figcaption>
  </div>
</figure>
