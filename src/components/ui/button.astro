---
import type { HTMLAttributes } from 'astro/types';
import Icon, { type IconName } from './icon.astro';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  icon?: IconName;
  size?: 'md' | 'lg';
}

const { href, icon, size = 'md', class: className, ...rest } = Astro.props;
---

<a
  href={href}
  class:list={[
    'group inline-flex items-center justify-center gap-2.5 overflow-hidden rounded-button border border-white/70 bg-ink font-semibold text-white shadow-button transition-[background-color,transform] duration-200 hover:bg-purple active:translate-y-px',
    'bg-[linear-gradient(180deg,rgb(255_255_255/0)_0%,rgb(255_255_255/0.08)_100%)]',
    size === 'md' ? 'h-11.5 pr-5 pl-4 text-base tracking-[-0.02em]' : 'h-12 pr-4 pl-5 text-lg font-medium tracking-[-0.02em]',
    className,
  ]}
  {...rest}
>
  <slot />
  {
    icon && (
      <Icon name={icon} class="transition-transform duration-200 group-hover:translate-x-0.5" />
    )
  }
</a>
