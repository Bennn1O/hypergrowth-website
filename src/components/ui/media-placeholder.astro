---
/**
 * Brand gradient stand-in for photos and mockups until real visuals are delivered.
 * Renders a <span> so it is valid inside phrasing content.
 */
interface Props {
  tone?: 'blush' | 'pink' | 'purple' | 'ink';
  class?: string;
}

const { tone = 'purple', class: className } = Astro.props;

const gradients = {
  blush: 'radial-gradient(120% 90% at 20% 10%, var(--color-white) 0%, var(--color-blush) 45%, var(--color-pink) 100%)',
  pink: 'radial-gradient(110% 90% at 80% 20%, var(--color-blush) 0%, var(--color-pink) 45%, var(--color-purple) 100%)',
  purple: 'radial-gradient(120% 100% at 30% 100%, var(--color-pink) 0%, var(--color-purple) 45%, var(--color-ink) 100%)',
  ink: 'radial-gradient(100% 80% at 70% 0%, var(--color-purple) 0%, var(--color-ink) 70%)',
} as const;
---

<span
  class:list={['block', className]}
  style={`background-image: url('/textures/grain.svg'), ${gradients[tone]};`}
  aria-hidden="true"></span>
