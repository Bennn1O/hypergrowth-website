---
/**
 * Cookie banner, same mechanics as the previous hypergrowth.fr: the choice is stored in
 * localStorage under `hpg-cookie-consent` ("accepted" | "declined"), so visitors who already
 * answered on the old site are not asked again. Rybbit itself loads from BaseLayout.
 */
import { getDictionary, localizePath, resolveLocale } from '../../i18n';

const locale = resolveLocale(Astro.currentLocale);
const t = getDictionary(locale).cookies;
const legalHref = localizePath('/mentions-legales', locale);
---

<div
  class="fixed inset-x-0 bottom-4 z-[60] hidden justify-center px-4 font-helvetica data-[open]:flex"
  data-cookie-banner
>
  <div
    role="region"
    aria-label={t.text}
    class="flex w-full max-w-[640px] items-center justify-between gap-5 rounded-[10px] bg-ink px-5 py-4 text-white shadow-[0_16px_40px_rgb(17_17_17/0.35)] max-sm:flex-col max-sm:items-start"
  >
    <p class="text-sm leading-snug text-white/75">
      {t.text}{' '}
      <a href={legalHref} class="text-white/50 underline underline-offset-2 hover:text-white">{t.more}</a>
    </p>
    <div class="flex shrink-0 items-center gap-2">
      <button type="button" class="rounded-[4px] border border-white/15 px-3 py-2 text-xs font-bold tracking-[0.04em] text-white/70 uppercase hover:text-white" data-consent="declined">
        {t.decline}
      </button>
      <button type="button" class="rounded-[4px] bg-primary px-3 py-2 text-xs font-bold tracking-[0.04em] text-white uppercase hover:bg-pink" data-consent="accepted">
        {t.accept}
      </button>
    </div>
  </div>
</div>

<script>
  const KEY = 'hpg-cookie-consent';
  const banner = document.querySelector<HTMLElement>('[data-cookie-banner]');

  function read(): string | null {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  }

  if (read() === null) banner?.setAttribute('data-open', '');

  banner?.addEventListener('click', (event) => {
    const choice = (event.target as HTMLElement).closest<HTMLElement>('[data-consent]')?.dataset.consent;
    if (!choice) return;
    try {
      localStorage.setItem(KEY, choice);
    } catch {
      /* private mode: the choice holds for this page only */
    }
    banner.removeAttribute('data-open');
  });
</script>
