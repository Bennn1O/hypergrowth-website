---
import { getDictionary, localizePath, resolveLocale } from '../../i18n';
import Logo from '../ui/logo.astro';
import LanguageSwitcher from './language-switcher.astro';

const locale = resolveLocale(Astro.currentLocale);
const t = getDictionary(locale);
const home = localizePath('/', locale);
---

<header
  class="pointer-events-none fixed inset-x-0 top-0 z-40 px-4 pt-3 transition-transform duration-500 ease-out-expo data-[hidden]:-translate-y-[130%] sm:px-6 sm:pt-4"
  data-site-header
>
  <div class="pointer-events-auto mx-auto flex max-w-site items-center justify-between gap-6">
    <a href={home} aria-label={t.a11y.home} class="bg-paper/80 px-3 py-2 text-[22px] leading-none backdrop-blur-md">
      <Logo />
    </a>
    <div class="flex items-center gap-3">
      <LanguageSwitcher class="hidden bg-paper/80 p-1 backdrop-blur-md sm:flex" />
      <a href="#cafe" class="label bg-ink px-4 py-3 text-paper transition-colors hover:bg-purple" data-magnetic>
        {t.timeline.contact}
      </a>
    </div>
  </div>
</header>
