---
import NavBar from './nav-bar.astro';

interface Props {
  /** Pages without the home motion show the bar from the start. */
  visible?: boolean;
}

const { visible = false } = Astro.props;
---

<!--
  Sticky header: the hero card already carries the navbar, so this compact bar only
  slides in once the hero is out of view, and steps aside over the footer's big logo.
-->
<header
  class="fixed inset-x-0 top-0 z-40 border-b border-ink/6 bg-white/85 px-5 py-3 backdrop-blur-md transition-transform duration-500 ease-out-expo data-[hidden]:-translate-y-full sm:px-[78px]"
  data-site-header
  data-hidden={visible ? undefined : ''}
>
  <NavBar compact class="mx-auto max-w-[1356px]" />
</header>
