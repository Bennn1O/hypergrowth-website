---
import Logomark from '../../assets/brand/logomark.svg';
import Logotype from '../ui/logotype.astro';
import { site } from '../../data/site';
import { getDictionary, localizePath, pagePath, resolveLocale, stripLocale } from '../../i18n';
import LanguageSwitcher from './language-switcher.astro';

const locale = resolveLocale(Astro.currentLocale);
const t = getDictionary(locale);
const f = t.footer;
const year = new Date().getFullYear();
const socials = site.socials.filter((social) => social.href);
const home = localizePath('/', locale);
const toHome = (hash: string) => (stripLocale(pagePath(Astro.url.pathname)) === '/' ? hash : `${home}${hash}`);
const legalHref = localizePath('/mentions-legales', locale);
---

<!--
  From Figma (HYPERGROWTH, « Footer - Exploration », node 376:799): a dark card inset 30px in a
  frame fading from ink to pink, bottom corners rounded 24px, the wordmark as a watermark.
-->
<footer
  data-dark
  data-clock={t.closing.clock}
  class="bg-[linear-gradient(180deg,#111111_8%,#ff82fd_100%)] p-3 font-helvetica text-white sm:p-[30px] sm:pt-0"
>
  <div class="relative isolate mx-auto max-w-[1452px] overflow-hidden rounded-b-[24px] bg-ink px-5 pt-14 pb-8 sm:px-[59px] sm:pt-9 sm:pb-8">
    <div class="pointer-events-none absolute inset-x-0 -bottom-[4%] -z-10 flex items-end justify-center gap-[1vw] text-[#171717]" aria-hidden="true" data-footer-logo>
      <Logotype class="h-auto w-[103%] max-w-none shrink-0" />
    </div>

    <div class="flex flex-col gap-24 sm:gap-32">
      <div class="flex flex-col gap-24">
        <div class="flex flex-col gap-12 md:flex-row md:items-start md:justify-between">
          <div class="flex max-w-[440px] flex-col items-start gap-6">
            <span class="flex items-center gap-[6px] text-xl">
              <Logomark class="h-8 w-auto text-pink sm:h-9" aria-hidden="true" />
              <span class="sr-only">HyperGrowth</span>
            </span>
            <p class="text-h3">
              {f.statement.map((part, i) => (i % 2 ? <span class="text-pink">{part}</span> : part))}
            </p>
            <a
              href={site.booking ?? toHome('#cafe')}
              target={site.booking ? '_blank' : undefined}
              rel={site.booking ? 'noopener' : undefined}
              data-cta="footer"
              class="rounded-[4px] bg-pink px-3 py-2 text-xs leading-3 font-medium tracking-[0.04em] text-white uppercase transition-colors hover:bg-white hover:text-ink"
              data-magnetic
            >
              {t.timeline.contact}
            </a>
          </div>

          <div class="flex min-w-[189px] flex-col items-start gap-3">
            <p class="text-xs leading-3 font-medium tracking-[0.04em] uppercase">{f.contactLabel}</p>
            {
              site.email ? (
                <a href={`mailto:${site.email}`} class="text-xl leading-7 font-medium tracking-[-0.03em] hover:text-pink">{site.email}</a>
              ) : (
                <p class="text-xl leading-7 font-medium tracking-[-0.03em]">{f.pending}</p>
              )
            }
            {socials.map((social) => (
              <a href={social.href!} rel="noopener" class="text-xl leading-7 font-medium tracking-[-0.03em] hover:text-pink">{social.label}</a>
            ))}
            <LanguageSwitcher
              class="gap-[3px] rounded-[8px] bg-white/10 p-[3px] backdrop-blur-xl [&_a]:rounded-[5px] [&_a]:px-[5px] [&_a]:py-[3px] [&_a]:text-xs [&_a]:leading-4 [&_a]:font-normal [&_a]:text-white/70 [&_a[aria-current]]:bg-white [&_a[aria-current]]:text-ink"
            />
          </div>
        </div>

        <nav aria-label={f.navLabel}>
          <ol class="border-t border-[#818181]">
            {
              t.timeline.stages.map((stage, index) => (
                <li class="border-b border-[#818181]">
                  <a href={toHome(`#${stage.id}`)} class="group flex items-center justify-between gap-6 py-5">
                    <span class="flex items-center gap-4 sm:gap-8">
                      <span class="text-base leading-3 font-medium tracking-[0.03em] text-[#818181]">{String(index + 1).padStart(2, '0')}</span>
                      <span class="text-h2 tracking-[-0.05em] transition-transform duration-500 ease-out-expo group-hover:translate-x-2">
                        {stage.lead} <span class="font-serif font-semibold tracking-[-0.04em] text-pink italic">{stage.accent}</span>
                      </span>
                    </span>
                    <span class="hidden text-base leading-3 font-medium tracking-[0.03em] whitespace-nowrap text-[#818181] uppercase sm:block">{stage.time}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </div>

      <div class="flex flex-col gap-3 text-xs leading-[1.3] font-medium tracking-[0.03em] uppercase sm:flex-row sm:items-center sm:justify-between sm:gap-4 sm:text-sm sm:leading-none">
        <p class="text-[#818181]">© {year} · HyperGrowth™ · <span class="whitespace-nowrap text-pink">{f.line}</span></p>
        <p class="flex flex-wrap gap-x-6 gap-y-2 whitespace-nowrap text-[#818181]">
          <a href={legalHref} class="hover:text-white">{f.legal}</a>
          <span>{f.rights}</span>
        </p>
        <a href="#top" class="flex items-center gap-1 self-start whitespace-nowrap text-white hover:text-pink sm:self-auto">
          {t.a11y.backToTop}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><circle cx="7" cy="11" r="0.9" stroke="currentColor" stroke-width="0.6" /><path d="M7 9V1.5m0 0L5 3.5M7 1.5l2 2" stroke="currentColor" stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>
    </div>
  </div>
</footer>
