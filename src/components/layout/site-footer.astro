---
import { getDictionary, resolveLocale } from '../../i18n';
import Logo from '../ui/logo.astro';
import LanguageSwitcher from './language-switcher.astro';

const locale = resolveLocale(Astro.currentLocale);
const t = getDictionary(locale);
const year = new Date().getFullYear();
---

<footer class="bg-ink px-4 pt-10 pb-6 text-paper sm:px-6">
  <div class="mx-auto flex max-w-site flex-col gap-10">
    <div class="flex items-center justify-between gap-6 text-[28px]">
      <Logo tone="light" />
      <LanguageSwitcher class="[&_a]:text-paper/60 [&_a[aria-current]]:bg-paper [&_a[aria-current]]:text-ink" />
    </div>
    <div class="flex flex-col justify-between gap-3 border-t border-paper/15 pt-5 sm:flex-row">
      <p class="label text-[11px] text-paper/60">
        {year} · HyperGrowth™ · <span class="text-pink">{t.footer.line}</span>
      </p>
      <p class="label flex gap-6 text-[11px] text-paper/40">
        <span>{t.footer.legal}</span>
        <span>{t.footer.rights}</span>
        <a href="#top" class="hover:text-pink">{t.a11y.backToTop} ↑</a>
      </p>
    </div>
  </div>
</footer>
