---
import Logomark from '../../assets/brand/logomark.svg';
import Logotype from '../../assets/brand/logotype.svg';
import { site } from '../../data/site';
import { getDictionary, localizePath, resolveLocale } from '../../i18n';
import Icon from '../ui/icon.astro';

const locale = resolveLocale(Astro.currentLocale);
const t = getDictionary(locale);
const home = localizePath('/', locale);
const year = new Date().getFullYear();

const menu = [
  [
    { label: t.nav.services, href: `${home}#services` },
    { label: t.nav.work, href: `${home}#work` },
  ],
  [
    { label: t.nav.studio, href: `${home}#studio` },
    { label: t.nav.contact, href: `${home}#contact` },
  ],
];
const socials = site.socials.filter((social) => social.href);
---

<footer id="contact" class="bg-black text-white">
  <div class="flex flex-col gap-12 overflow-hidden p-6 sm:p-12">
    <div class="flex flex-col gap-12 lg:flex-row lg:items-stretch lg:justify-between">
      <div class="flex flex-1 flex-col justify-between gap-10 lg:h-[220px]">
        <div class="flex flex-col gap-8">
          <p class="text-[10px] font-medium tracking-[0.04em] text-steel uppercase">{t.footer.mainMenu}</p>
          <nav aria-label={t.footer.mainMenu}>
            <ul class="flex flex-col gap-3">
              {
                menu.map((row) => (
                  <li class="flex flex-wrap items-center gap-3">
                    {row.map((link, index) => (
                      <>
                        {index > 0 && <span class="h-6 w-px rotate-[44deg] bg-steel" aria-hidden="true" />}
                        <a
                          href={link.href}
                          class="text-[28px] leading-[1.2] tracking-[-0.01em] [background:linear-gradient(var(--color-purple),var(--color-purple))_no-repeat_0_100%/0_12px] transition-[background-size] duration-300 hover:[background-size:100%_12px]"
                        >
                          {link.label}
                        </a>
                      </>
                    ))}
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </div>

      <div class="flex flex-1 flex-col justify-between gap-10 lg:h-[220px]">
        <div class="flex items-start justify-between gap-8">
          <div class="flex flex-col gap-8">
            <p class="text-[10px] font-medium tracking-[0.04em] text-steel uppercase">{t.footer.contactUs}</p>
            <ul class="flex flex-col gap-1 text-base">
              {site.phone && <li><a href={`tel:${site.phone.replace(/\s/g, '')}`} class="text-pink">{site.phone}</a></li>}
              {site.email && <li><a href={`mailto:${site.email}`} class="text-steel hover:text-white">{site.email}</a></li>}
              {!site.phone && !site.email && <li class="text-steel">{site.url.replace('https://', '')}</li>}
            </ul>
          </div>
          {
            socials.length > 0 && (
              <div class="flex flex-col items-end gap-8 text-right">
                <p class="text-[10px] font-medium tracking-[0.04em] text-steel uppercase">{t.footer.followUs}</p>
                <ul class="flex flex-col items-end gap-1 text-base">
                  {socials.map((social) => (
                    <li>
                      <a href={social.href!} rel="noopener" class="hover:text-pink">
                        {social.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
        <div class="flex items-end justify-between gap-6">
          <p class="text-sm text-steel">{site.address}</p>
          <a href="#top" aria-label={t.a11y.backToTop} class="text-pink transition-transform hover:-translate-y-1">
            <Icon name="arrow-up" size={24} strokeWidth={1.4} />
          </a>
        </div>
      </div>
    </div>

    <div class="flex items-center justify-center gap-[0.14em] text-wordmark" aria-hidden="true">
      <Logomark class="h-[1.05em] w-auto shrink-0 text-purple" />
      <Logotype class="h-[0.82em] w-auto text-white [&_.growth]:text-pink" />
    </div>
  </div>

  <div class="flex flex-col gap-2 bg-night px-6 py-4 text-sm text-steel/60 sm:flex-row sm:px-12">
    <p class="flex-1">© {year} — HyperGrowth</p>
    <div class="flex flex-1 justify-between gap-6">
      <span>{t.footer.privacy}</span>
      <span>{t.footer.rights}</span>
    </div>
  </div>
</footer>
